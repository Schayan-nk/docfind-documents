# docfind-documents: every setting is an environment variable. Copy this file
# to .env beside the binary (or name it with -env-file) and fill in what you
# use. Real variables in the environment win over this file unless
# -env-file-wins is given. Never commit the filled-in copy.

# ---------------------------------------------------------------- archive
# The folder of documents. -archive on the command line wins over this. A
# folder that cannot be read is not fatal: the page says why, and an
# administrator can name another one there.
DOCFIND_ARCHIVE=/srv/archive

# ---------------------------------------------------------------- database
# Optional. Without it accounts are kept in the accounts file (-users) and the
# audit trail goes to the log only. With it, accounts, the audit trail and the
# settings live in PostgreSQL; the schema is created and upgraded on start.
#DOCFIND_PG_HOST=127.0.0.1
#DOCFIND_PG_PORT=5432
#DOCFIND_PG_USER=documents
#DOCFIND_PG_PASSWORD=change-me
#DOCFIND_PG_DATABASE=documents
# disable | require | verify-ca | verify-full
#DOCFIND_PG_SSLMODE=disable
# 1 keeps the text extracted from each document in PostgreSQL, so a rescan
# never extracts or OCRs a document twice. The local index cache is encrypted;
# the text in PostgreSQL is not, so turn this on only where the database's
# disk may hold it.
#DOCFIND_PG_DOCTEXT=0
# Queries slower than this many milliseconds are logged.
#DOCFIND_SLOW_QUERY_MS=500

# ---------------------------------------------------------------- HTTPS
# Serve TLS directly. Leave unset behind a reverse proxy that terminates TLS.
# Passkeys and the installed app need a secure page.
#DOCFIND_TLS_CERT=/etc/documents/fullchain.pem
#DOCFIND_TLS_KEY=/etc/documents/privkey.pem

# ---------------------------------------------------------------- passkeys
# The host name passkeys are bound to. A passkey belongs to this name for
# good: change it and every registered passkey stops working.
#DOCFIND_PASSKEY_RPID=docs.example.com
# The origins pages are served from, comma separated, each https on that host.
#DOCFIND_PASSKEY_ORIGINS=https://docs.example.com

# ---------------------------------------------------------------- Word editor
# An ONLYOFFICE Document Server, as this server reaches it. Editing in the
# browser is off unless this is set.
#DOCFIND_OFFICE_URL=http://127.0.0.1:8090
# A file holding the JWT secret the Document Server is configured with (its
# JWT_SECRET), at least 32 characters. Default: office.key beside the
# accounts file. You create it; the server only reads it.
#DOCFIND_OFFICE_KEY_FILE=/etc/documents/office.key
# This server as the Document Server reaches it, when that is not this
# machine's own port on 127.0.0.1.
#DOCFIND_OFFICE_SELF_URL=http://10.0.0.5:8310

# ---------------------------------------------------------------- uploads
# Every upload is held in a quarantine folder and scanned by Microsoft
# Defender where it is installed (Windows) before it reaches the archive.
# "off" skips the scan.
#DOCFIND_UPLOAD_AV=on

# ---------------------------------------------------------------- sign-in codes
# Two-step sign-in by email: a mailbox to send the codes from. Port 465 is TLS
# from the start, 587 is STARTTLS; nothing is sent over a plain connection.
#DOCFIND_SMTP_HOST=smtp.example.com
#DOCFIND_SMTP_PORT=465
#DOCFIND_SMTP_USERNAME=codes@example.com
#DOCFIND_SMTP_PASSWORD=
#DOCFIND_SMTP_FROM=codes@example.com
# Two-step sign-in by SMS, and resetting a forgotten password by SMS. The
# panel's REST API (the default URL is Asanak's).
#DOCFIND_SMS_URL=
#DOCFIND_SMS_USERNAME=
#DOCFIND_SMS_PASSWORD=
#DOCFIND_SMS_API_KEY=
# The sender number, in international form without the plus.
#DOCFIND_SMS_FROM=

# ---------------------------------------------------------------- logs
# Default: a logs folder beside the accounts file.
#DOCFIND_LOG_DIR=
#DOCFIND_LOG_KEEP_DAYS=30
#DOCFIND_LOG_MAX_DAY_MB=200
